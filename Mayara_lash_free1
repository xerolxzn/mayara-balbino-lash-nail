    <script>
        document.addEventListener('DOMContentLoaded', () => {
            renderizarConfig();
            inicializarObserver();
            inicializarHeaderScroll();
        });

        function renderizarConfig() {
            // Links do WhatsApp
            const waUrl = `https://wa.me/${CONFIG.whatsappNumber}?text=${encodeURIComponent(CONFIG.whatsappMessage)}`;
            document.querySelectorAll('.main-wa-link').forEach(link => {
                link.setAttribute('href', waUrl);
            });

            // Renderizar Unhas
            const nailBox = document.getElementById('nail-grid');
            if (nailBox) {
                nailBox.innerHTML = CONFIG.nailServices.map(item => {
                    const msg = `Olá Mayara! Gostaria de agendar o procedimento de ${item.name} (${item.price}).`;
                    const url = `https://wa.me/${CONFIG.whatsappNumber}?text=${encodeURIComponent(msg)}`;
                    
                    return `
                        <div class="nail-luxury-card reveal">
                            <div>
                                <div class="nail-card-top">
                                    <h4>${item.name}</h4>
                                    <span class="price">${item.price}</span>
                                </div>
                                <p class="nail-card-desc">${item.description}</p>
                            </div>
                            <a href="${url}" class="nail-card-btn" target="_blank" rel="noopener">
                                <span>Agendar procedimento</span>
                                <svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"/></svg>
                            </a>
                        </div>
                    `;
                }).join('');
            }

            // Renderizar Depoimentos
            const revBox = document.getElementById('reviews-grid');
            if (revBox) {
                revBox.innerHTML = CONFIG.whatsappFeedbacks.map(rev => {
                    return `
                        <div class="review-luxury-card reveal">
                            <div>
                                <div class="review-stars">★★★★★</div>
                                <p class="review-text">"${rev.message}"</p>
                            </div>
                            <div class="review-client-info">
                                <div class="client-avatar">${rev.clientName[0]}</div>
                                <div class="client-meta">
                                    <h5>${rev.clientName}</h5>
                                    <span>${rev.subtext}</span>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            // Renderizar FAQ
            const faqBox = document.getElementById('faq-accordion');
            if (faqBox) {
                faqBox.innerHTML = CONFIG.faqs.map((faq, index) => {
                    return `
                        <div class="faq-item reveal" onclick="toggleFaq(this)">
                            <div class="faq-question">
                                <span>${faq.question}</span>
                                <span class="faq-icon">+</span>
                            </div>
                            <div class="faq-answer">
                                <p>${faq.answer}</p>
                            </div>
                        </div>
                    `;
                }).join('');
            }
        }

        function toggleFaq(el) {
            const isActive = el.classList.contains('active');
            document.querySelectorAll('.faq-item').forEach(item => item.classList.remove('active'));
            if (!isActive) el.classList.add('active');
        }

        function filtrarGaleria(cat, btn) {
            document.querySelectorAll('.portfolio-tab-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            document.querySelectorAll('.portfolio-item-card').forEach(card => {
                const itemCat = card.getAttribute('data-cat');
                if (cat === 'todos' || itemCat === cat) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function inicializarObserver() {
            const obs = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                    }
                });
            }, { threshold: 0.08 });

            document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
        }

        function inicializarHeaderScroll() {
            const header = document.getElementById('header');
            window.addEventListener('scroll', () => {
                if (window.scrollY > 40) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            });
        }

        const nav = document.getElementById('nav');
        const btnMenu = document.getElementById('btn-menu');

        function toggleMenu() {
            nav.classList.toggle('open');
            btnMenu.classList.toggle('open');
        }

        function closeMenu() {
            nav.classList.remove('open');
            btnMenu.classList.remove('open');
        }
    </script>
